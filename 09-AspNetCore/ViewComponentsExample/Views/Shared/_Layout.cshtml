<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ViewComponents Demo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/StyleSheet.css" asp-append-version="true" />
</head>
<body>
    <div class="container">
        <header class="navbar">
            <div class="navbar-brand">
                <span class="brand-icon">⚡</span>
                <span>ViewComponents Demo</span>
            </div>
            <nav>
                <ul class="nav-links">
                    <li><a href="/" class="nav-link">Home</a></li>
                    <li><a href="/About" class="nav-link">About</a></li>
                </ul>
            </nav>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>

        <footer class="footer">
            <p>&copy; @DateTime.Now.Year ASP.NET Core Learning &bull; ViewComponents</p>
        </footer>
    </div>
</body>
</html>