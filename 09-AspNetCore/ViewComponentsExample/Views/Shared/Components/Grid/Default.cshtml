@model PersonGridModel

<div class="box">
    <div class="box-header">
        <div class="box-title">
            <span class="box-badge">ViewComponent</span>
            <h3>@Model.GridTitle</h3>
        </div>
        <span class="badge-count">2 Records</span>
    </div>

    <div class="table-responsive">
        <table class="table w-100">
            <thead>
                <tr>
                    <th style="width: 140px;">Sl. No</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach(Person person in Model.People)
                {
                    <tr>
                        <td class="font-medium">@person.PersonName</td>
                        <td class="font-medium">@person.JobTitle</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>